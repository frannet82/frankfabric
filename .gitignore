# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# perf: source-of-truth asset tree for scripts/compress-assets.mjs (FEAT-002).
# It holds pristine originals so the compressor never recompresses its own
# output; must NEVER be committed.
/assets-src/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env*.local
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
